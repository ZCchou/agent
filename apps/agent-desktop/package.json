    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "dompurify": "^3.4.17",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "mermaid": "11.17.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
