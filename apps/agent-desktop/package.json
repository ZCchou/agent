{
  "name": "agent-desktop",
  "private": true,
  "version": "0.16.0-preview.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "npm run build && npm run verify:sidecar",
    "test": "vitest run src",
    "test:ui": "playwright test",
    "check": "npm run test && npm run test:ui && npm run build",
    "preview": "vite preview",
    "verify:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/verify-python-sidecar.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/release-windows.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
