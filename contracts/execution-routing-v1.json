    "interrupted", "stale"
  ],
  "step_kinds": [
    "intent_analysis", "vision_analysis", "web_research",
    "reasoning_analysis", "final_response"
  ],
  "step_statuses": [
    "queued", "running", "completed", "failed", "cancelled",
    "interrupted", "unknown_outcome"
  ],
  "events": [
    "run.planning_started", "run.plan_ready", "run.waiting_permission",
    "run.waiting_budget", "run.step_started", "run.step_completed",
    "run.step_failed", "run.synthesis_started"
  ],
  "reason_codes": [
    "fixed_selection", "coordinator_reused", "automatic_single_model",
