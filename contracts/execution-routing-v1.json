  "ipc_version": 9,
  "settings_schema_version": 11,
  "core_schema_version": 13,
  "build_id": "schema13-execution-routing-v1",
  "selection_modes": ["fixed", "automatic"],
  "routing_presets": ["quality", "balanced", "economy", "local_first"],
  "plan_statuses": [
    "resolving", "waiting_permission", "waiting_budget", "planned",
