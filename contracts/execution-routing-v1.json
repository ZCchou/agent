  ],
  "errors": [
    "no_compatible_execution_plan", "coordinator_model_unavailable",
    "capability_combination_unsupported", "routing_permission_required",
    "routing_budget_confirmation_required", "routing_budget_exceeded",
    "routing_price_unknown", "execution_plan_stale", "execution_step_failed",
    "execution_step_unknown_outcome", "execution_artifact_budget_exceeded",
    "routing_intent_invalid", "model_capability_unverified",
    "automatic_routing_not_available"
  ],
  "defaults": {
    "new_conversation_mode": "automatic",
    "routing_preset": "balanced",
    "max_model_calls_per_message": 3,
    "max_specialist_steps": 2,
    "max_extra_online_cost_usd": "0.20",
    "allow_unknown_price_automatic": false
  },
  "hard_limits": {
    "max_model_calls_per_message": 6,
    "max_specialist_steps": 2,
    "max_extra_online_cost_usd": "5.00",
    "max_artifact_bytes": 65536,
    "max_plan_artifact_bytes": 131072
  }
